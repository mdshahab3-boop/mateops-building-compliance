# ---------------------------------------------------------------------------
# Copy to .env and replace every value. Never commit .env.
# Generate secrets with:  openssl rand -base64 48
# ---------------------------------------------------------------------------

NODE_ENV=development
APP_URL=http://localhost:3000
# Public base used in QR verification links and certificates.
# On the VPS set this to how users reach the app, e.g. http://72.61.209.94:3100
# or https://induction.yourdomain.com once Caddy/HTTPS is set up.
PUBLIC_URL=http://localhost:3000

# Host port the web app is published on (container always listens on 3000).
# Defaults to 3100 to avoid clashing with other services (e.g. n8n on 3000).
WEB_PORT=3100

# --- PostgreSQL ------------------------------------------------------------
# Superuser (owner) — used ONLY for migrations. Bypasses RLS by design.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-superuser
POSTGRES_DB=scip
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_ADMIN_URL=postgres://postgres:change-me-postgres-superuser@localhost:5432/scip

# Least-privilege application role. RLS is ENFORCED for this role.
# The password here must match APP_DB_PASSWORD (used by the DB init script).
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-app-user
DATABASE_URL=postgres://app_user:change-me-app-user@localhost:5432/scip

# --- Redis (background jobs, Stage 6) --------------------------------------
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO / S3-compatible) --------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-2
S3_ACCESS_KEY=change-me-minio-access
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET_DOCUMENTS=scip-documents
S3_BUCKET_CERTIFICATES=scip-certificates
S3_FORCE_PATH_STYLE=true

# --- Auth ------------------------------------------------------------------
# 48+ byte random string. Rotating it invalidates all sessions.
SESSION_SECRET=change-me-session-secret-at-least-32-bytes
SESSION_TTL_HOURS=12

# --- Email (transactional, Stage 5/O) --------------------------------------
SMTP_URL=
EMAIL_FROM=no-reply@tmmanagementservices.com.au
