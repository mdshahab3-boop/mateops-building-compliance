# Copy to apps/web/.env.local for local development (git-ignored).
# In Docker/production these come from the container environment instead.

NODE_ENV=development
APP_URL=http://localhost:3000
# Public base used in QR verification links and certificates.
PUBLIC_URL=http://localhost:3000

# App (least-privilege) role — RLS enforced.
DATABASE_URL=postgres://app_user:app_pw@127.0.0.1:5432/scip
# Owner/superuser — used only by the migration runner and the seed script.
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/scip

# 32+ char random string. openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-1234567890
SESSION_TTL_HOURS=12
