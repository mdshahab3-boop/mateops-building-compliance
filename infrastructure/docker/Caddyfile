# Replace scip.example.com with your real domain (pointed at the VPS).
# Caddy will obtain and renew a Let's Encrypt certificate automatically.
# For local testing, use:  localhost { reverse_proxy web:3000 }

scip.example.com {
	encode zstd gzip
	reverse_proxy web:3000

	header {
		# Security headers (tune CSP once the UI's asset origins are known).
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
