{
  "name": "mateops-building-compliance",
  "version": "0.1.0",
  "private": true,
  "description": "MateOps Building Compliance — multi-tenant contractor induction & compliance platform",
  "type": "module",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "pnpm --filter @scip/db migrate",
    "migrate:status": "pnpm --filter @scip/db migrate:status",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
