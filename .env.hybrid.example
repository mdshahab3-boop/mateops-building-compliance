# ===========================================================================
# HYBRID deployment — app on a VPS (Docker), data on managed/edge services.
#   Database  -> Neon Postgres (managed)         : no data migration when you
#   Storage   -> Cloudflare R2 (S3-compatible)   :   later move app to Workers
#   Jobs      -> Redis (in this compose)
#   Ingress   -> Cloudflare Tunnel (cloudflared) : no open ports, TLS by CF
# Copy to `.env` on the VPS and fill every value. NEVER commit .env.
# Generate secrets with:  openssl rand -base64 48
# ===========================================================================

NODE_ENV=production
# Public URL the app is reached at (through the Cloudflare Tunnel).
APP_URL=https://bc.mateops.com.au
PUBLIC_URL=https://bc.mateops.com.au

# --- Neon Postgres ---------------------------------------------------------
# Owner/admin connection — used ONLY for migrations (bypasses RLS). From Neon.
DATABASE_ADMIN_URL=postgresql://OWNER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
# Least-privilege app role (RLS ENFORCED). Create it on Neon first with
# infrastructure/neon/00-app-user.sql, then put its credentials here.
APP_DB_USER=app_user
APP_DB_PASSWORD=REPLACE_WITH_APP_USER_PASSWORD
DATABASE_URL=postgresql://app_user:REPLACE_WITH_APP_USER_PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# --- Redis (background jobs) — internal to the compose network -------------
REDIS_URL=redis://redis:6379

# --- Cloudflare R2 (S3-compatible) ----------------------------------------
# Endpoint = https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://607dbd1c036f9b4ef08f4f8871f45ddb.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=REPLACE_WITH_R2_ACCESS_KEY_ID
S3_SECRET_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
S3_BUCKET_DOCUMENTS=mateops-compliance-documents
S3_BUCKET_CERTIFICATES=mateops-compliance-certificates
S3_FORCE_PATH_STYLE=true

# --- Auth ------------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_48_BYTE_RANDOM
SESSION_TTL_HOURS=12

# --- Email (transactional; optional to start) ------------------------------
SMTP_URL=
EMAIL_FROM=no-reply@mateops.com.au

# --- Cloudflare Tunnel -----------------------------------------------------
# Zero Trust -> Networks -> Tunnels -> create -> copy the token.
TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
